# Copiar a .env para desarrollo local. En EasyPanel estas mismas variables se
# cargan desde el entorno de la app y tienen prioridad sobre el archivo.

# Base de datos PostgreSQL. Las cinco son obligatorias: si falta alguna,
# config/database.php aborta con 500 en vez de arrancar mal configurado.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Dominio público de la app. Cuelgan de él las dos cosas que se le pasan a
# alguien de afuera:
#
#   {QR_BASE_URL}/{serial}   ← lo que codifica el QR impreso
#   {QR_BASE_URL}/{token}    ← el link para la grabadora
#
# Sin esto definido no se emite ninguna imagen, porque la URL queda embebida en
# el código y no se corrige después. Y el link de la grabadora sale relativo,
# o sea con el dominio por el que se entró al panel en vez de este.
#
# Cuanto más corto el dominio, menos módulos tiene el QR y de más lejos se lee:
# con qr.example.com el código entra en 29x29 en vez de 33x33.
QR_BASE_URL=https://qr.example.com

# Contraseña del panel: va el hash bcrypt, codificado en base64 (no la
# contraseña en claro, y no el hash "pelado"). Se genera con:
#   php -r 'echo base64_encode(password_hash("la-que-elijas", PASSWORD_DEFAULT)), "\n";'
# y se pega el resultado acá. Si queda vacío no se puede entrar al panel.
#
# ¿Por qué base64 y no el hash directo? Un hash bcrypt empieza con "$2y$10$...",
# y varios sistemas de variables de entorno (Docker Compose entre ellos)
# interpretan un "$" como el inicio de otra variable y truncan el valor sin
# avisar. En base64 no hay ningún carácter especial que se preste a eso.
ADMIN_PASSWORD_HASH_B64=

# URL pública de la app (opcional, sólo informativa). El dominio que usan los
# links y los QR sale de QR_BASE_URL, no de acá.
APP_URL=https://qr.example.com
